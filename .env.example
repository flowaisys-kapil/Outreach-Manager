# Outreach Manager Environment Configuration (.env.example)

# ==============================================================================
# Primary LLM Configuration
# ==============================================================================
# Provider and model identifier formatted as provider:model (e.g. openai:gpt-4o, anthropic:claude-3-5-sonnet-latest, google:gemini-1.5-flash)
AI_MODEL=openai:gpt-4o
LLM_API_KEY=
LLM_API_BASE=

# Rate-limit pacing delay in seconds between LLM API calls
LLM_RATE_LIMIT_DELAY=3.0

# ==============================================================================
# Backup LLM Configuration (Optional Failover)
# ==============================================================================
BACKUP_AI_MODEL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_API_BASE=

# ==============================================================================
# LinkedIn Credentials
# ==============================================================================
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ==============================================================================
# Browser & CDP (Chrome DevTools Protocol) Configuration
# ==============================================================================
# Set to True when connecting to an existing Chrome browser instance with remote debugging
USE_CDP=False
CDP_URL=http://127.0.0.1:9222

# ==============================================================================
# Session & Scheduler Pacing Configuration
# ==============================================================================
# Time window (in hours) to distribute tasks during manual execution cycles
SCHEDULER_HORIZON_HOURS=1.0

# If True, schedules planned tasks to execute sequentially in immediate batch mode
SCHEDULER_IMMEDIATE_MODE=True

# Human-like delay range (in seconds) between individual workflow actions
SCHEDULER_MIN_DELAY_BETWEEN_TASKS=30
SCHEDULER_MAX_DELAY_BETWEEN_TASKS=60

# Maximum action caps per session cycle
SCHEDULER_MAX_CONNECTS_PER_RUN=10
SCHEDULER_MAX_FOLLOW_UPS_PER_RUN=12

# ==============================================================================
# Container & Deployment Configuration
# ==============================================================================
ENABLE_VNC=false
HOST_UID=1000
HOST_GID=1000
